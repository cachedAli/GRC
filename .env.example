# Copy to .env and fill in as needed. Every value is optional — the site
# runs without them, with reduced functionality noted below.

# ComplyChat (website AI concierge, /api/complychat).
# Unset -> the widget serves keyword-matched scripted answers and still works.
# Set -> answers come from Claude (claude-opus-5) using the product facts in
# app/api/complychat/route.ts.
ANTHROPIC_API_KEY=

# Demo requests (/api/demo-request).
# SMTP credentials. Use your email provider's SMTP host and an app password,
# rather than your normal mailbox password. SMTP_SECURE is true only for port 465.
# Unset -> submissions are validated and logged server-side only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DEMO_RECIPIENT_EMAIL=

# Optional: each validated request is also POSTed as JSON to this URL (CRM / Zapier).
DEMO_WEBHOOK_URL=
